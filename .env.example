# ===========================================
# ORGANIC SEO - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# === DATABASE (Required) ===
# Get free Postgres from Vercel Storage > Neon
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# === AUTHENTICATION (Required) ===
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-here
# Your production URL (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# === AI API KEYS (Required) ===
# Perplexity: https://docs.perplexity.ai/
PERPLEXITY_API_KEY=your_perplexity_api_key

# RapidAPI (for ChatGPT): https://rapidapi.com/
RAPIDAPI_KEY=your_rapidapi_key

# Google Gemini: https://ai.google.dev/
GOOGLE_AI_API_KEY=your_google_ai_api_key

# === WEBSITE CRAWLING (Optional) ===
# Firecrawl: https://firecrawl.dev/ - Falls back to Perplexity if not set
FIRECRAWL_API_KEY=your_firecrawl_api_key

# === EMAIL (Required for password reset) ===
# Resend: https://resend.com/
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="Organic SEO <noreply@yourdomain.com>"

# === PAYPAL PAYMENTS (Required for paid plans) ===
# PayPal Developer: https://developer.paypal.com/
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your_webhook_id

# PayPal subscription plan IDs (create in PayPal dashboard)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
NEXT_PUBLIC_PAYPAL_STARTER_PLAN_ID=your_starter_plan_id
NEXT_PUBLIC_PAYPAL_PROFESSIONAL_PLAN_ID=your_professional_plan_id
NEXT_PUBLIC_PAYPAL_ENTERPRISE_PLAN_ID=your_enterprise_plan_id
